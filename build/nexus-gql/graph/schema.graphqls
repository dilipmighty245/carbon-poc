    AuditRecords(Id: ID): [runtime_AuditRecord!]
    PassportID: String
    TenantID: String
    FacilityID: String
    BatchID: String
    CommodityType: String
    TotalFootprintKg: Float
    Scope1Kg: Float
    Scope2Kg: Float
