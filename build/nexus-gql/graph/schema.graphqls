scalar Map
type Query {
    root: root_Root
}

type root_Root {
    Id: ID
	ParentLabels: Map

    Config: config_Config!
    Inventory: inventory_Inventory!
    Runtime: runtime_Runtime!
}

type config_Config {
    Id: ID
	ParentLabels: Map

    Rulebooks(Id: ID): [config_Rulebook!]
    CbamBenchmarks(Id: ID): [config_CbamBenchmark!]
    StoryboardScenes(Id: ID): [config_StoryboardScene!]
}

type config_Rulebook {
    Id: ID
	ParentLabels: Map

    RulebookID: String
    CommodityType: String
    Version: String
    AccountingMode: String
    Standard: String
    RulesRaw: String
    Scope1Formula: String
    Scope2Formula: String
    Scope3Formula: String
    FunctionalUnit: String
    BatchQuantity: Float
    BoundaryType: String
    AllocationMethod: String
}

type config_CbamBenchmark {
    Id: ID
	ParentLabels: Map

    CnCode: String
    CommodityName: String
    BfBofBenchmark: Float
    DriEafBenchmark: Float
    ScrapEafBenchmark: Float
    DefaultFallback: Float
    RegulationRef: String
}

type config_StoryboardScene {
    Id: ID
	ParentLabels: Map

    SceneNumber: Int
    Title: String
    ScreenRoute: String
    PresenterNarration: String
    PrimaryAction: String
    TargetModule: String
}

type inventory_Inventory {
    Id: ID
	ParentLabels: Map

    Agencies(Id: ID): [inventory_ACVAgency!]
    Tenants(Id: ID): [inventory_Tenant!]
    Suppliers(Id: ID): [inventory_Supplier!]
}

type inventory_ACVAgency {
    Id: ID
	ParentLabels: Map

    AgencyID: String
    LegalName: String
    AccreditationBody: String
    AccreditationNumber: String
    AccreditationStatus: String
    AccreditationExpiry: String
}

type inventory_Tenant {
    Id: ID
	ParentLabels: Map

    Facilities(Id: ID): [inventory_Facility!]
    Processes(Id: ID): [inventory_Process!]
    ReportingPeriods(Id: ID): [inventory_ReportingPeriod!]
    Localisation(Id: ID): [inventory_Localisation!]
    Approvals(Id: ID): [inventory_Approval!]
    VerificationAgencies(Id: ID): [inventory_VerificationAgency!]
    VerificationEngagements(Id: ID): [inventory_VerificationEngagement!]
    EngagementTeamMembers(Id: ID): [inventory_EngagementTeamMember!]
    COIDeclarations(Id: ID): [inventory_COIDeclaration!]
    Findings(Id: ID): [inventory_Finding!]
    ReviewSignoffs(Id: ID): [inventory_ReviewVerdict!]
    InputCorrections(Id: ID): [inventory_InputCorrection!]
    Products(Id: ID): [inventory_Product!]
    TenantID: String
    LegalName: String
    Country: String
    Industry: String
    ProfileRaw: String
}

type inventory_Facility {
    Id: ID
	ParentLabels: Map

    Meters(Id: ID): [inventory_Meter!]
